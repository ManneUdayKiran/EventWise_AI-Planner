# EventWise AI Environment Configuration Example
# Copy this file to .env and configure appropriate values

# Environment
ENVIRONMENT=development
DEBUG=true

# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017
DB_NAME=eventwise_ai

# Security & Authentication
SECRET_KEY=change-this-to-a-super-secret-random-key-at-least-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# AI Provider Configuration
# Supported providers: "groq" (recommended), "gemini", "sample" (offline fallback)
AI_PROVIDER=groq

# Groq Cloud GenAI Settings
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

# Google Gemini Settings (Optional)
GEMINI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Execution Limits
AI_REQUEST_TIMEOUT_SECONDS=25
AI_MAX_CONCURRENCY=5

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60
